{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-after-edit.sh",
        "matcher": "Write"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-shell.sh",
        "matcher": "git push --force|git push -f|rm -rf /|drop database|DROP DATABASE"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/on-stop.sh",
        "loop_limit": 3
      }
    ]
  }
}
